[Unit]
Description=Read-only GPU and tmux monitor
After=network.target tailscaled.service
ConditionPathExists=!/path/to/lydiard/.local/gpu-monitor-cron-managed

[Service]
Type=simple
WorkingDirectory=/path/to/lydiard
ExecStart=/usr/local/bin/node /path/to/lydiard/gpu-monitor/server.mjs
Restart=on-failure
RestartSec=3
Environment=GPU_MONITOR_PORT=8789
Environment=PATH=/usr/local/bin:/usr/local/bin:/usr/bin:/bin
StandardOutput=append:/path/to/lydiard/progress/logs/gpu-monitor.log
StandardError=append:/path/to/lydiard/progress/logs/gpu-monitor.log

[Install]
WantedBy=default.target
