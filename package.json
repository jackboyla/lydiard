{
  "name": "lydiard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wisdom:ensure": "node scripts/ensure-wisdom.mjs",
    "predev": "npm run wisdom:ensure",
    "dev": "vite --host 0.0.0.0",
    "server": "tsx server/stravaServer.ts",
    "preworker:dev": "npm run wisdom:ensure",
    "worker:dev": "wrangler dev",
    "worker:deploy": "npm run build && wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply lydiard --local",
    "d1:migrate": "wrangler d1 migrations apply lydiard --remote",
    "garmin:audit": "tsx scripts/garmin-health-audit.ts",
    "garmin:import-db": "tsx scripts/garmin-health-import.ts",
    "garmin:backfill-laps": "tsx scripts/garmin-laps-backfill.ts",
    "garmin:import-gym": "tsx scripts/garmin-gym-import.ts",
    "fitbit:import": "tsx scripts/fitbit-recovery-import.ts",
    "google-health:auth": "tsx scripts/google-health-auth.ts",
    "backup:d1": "tsx scripts/d1-backup.ts",
    "backup:verify": "tsx scripts/verify-d1-backup.ts",
    "backup:drive:auth": "tsx scripts/google-drive-backup-auth.ts",
    "backup:drive:upload": "tsx scripts/google-drive-backup-upload.ts",
    "plan:import": "tsx scripts/import-plan-csv.ts",
    "garmin:sync": "npm run garmin:import-db",
    "coach:smoke": "tsx scripts/coach-engine-smoke.ts",
    "load-forecast:smoke": "tsx scripts/load-forecast-smoke.ts",
    "agent-plan:smoke": "tsx scripts/agent-plan-smoke.ts",
    "best-efforts:smoke": "tsx scripts/best-efforts-smoke.ts",
    "lap-profile:smoke": "tsx scripts/lap-profile-smoke.ts",
    "product:smoke": "tsx scripts/product-journey-smoke.ts",
    "mobile-note:smoke": "tsx scripts/mobile-note-smoke.ts",
    "weekly-totals:smoke": "tsx scripts/weekly-totals-smoke.ts",
    "recovery:smoke": "tsx scripts/recovery-smoke.ts",
    "gpu-monitor": "node gpu-monitor/server.mjs",
    "gpu-monitor:test": "node --test gpu-monitor/monitor.test.mjs",
    "gpu-monitor:watchdog": "bash gpu-monitor/watchdog.sh",
    "prebuild": "npm run wisdom:ensure",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@mapbox/polyline": "^1.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "hono": "^4.12.27",
    "lucide-react": "^1.17.0",
    "maplibre-gl": "^5.24.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260701.1",
    "@types/express": "^5.0.6",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^25.9.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "playwright": "^1.60.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wrangler": "^4.106.0"
  },
  "license": "MIT",
  "description": "A running diary with a coach behind it, running on Cloudflare Workers and D1.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackboyla/lydiard.git"
  }
}
